#!/usr/bin/python3
import sys, argparse

def sdbm_hash(s: str) -> int:
    h = 0
    for ch in s.encode('utf-8'):
        h = (ch + ((h << 6) & 0xFFFFFFFFFFFFFFFF) + ((h << 16) & 0xFFFFFFFFFFFFFFFF) - h) & 0xFFFFFFFFFFFFFFFF
    return h

class LCG8:
    a, c, m = 1103515245, 12345, 256
    def __init__(self, seed: int): self.x = seed & 0xFF
    def next_byte(self): self.x = (self.a*self.x + self.c) % self.m; return self.x

def main():
    p = argparse.ArgumentParser(prog="scrypt", description="Stream cipher with LCG(8-bit) keystream from sdbm(password).")
    p.add_argument("password"); p.add_argument("infile"); p.add_argument("outfile")
    p.add_argument("-D", action="store_true"); p.add_argument("-s", action="store_true"); p.add_argument("-i", action="store_true")
    a = p.parse_args()
    if a.i: print("scrypt: XOR stream cipher using sdbm(password) -> 8-bit LCG keystream."); return
    seed = sdbm_hash(a.password)
    if a.s: print(f"seed={seed}")
    rng = LCG8(seed)
    with open(a.infile, "rb") as fi, open(a.outfile, "wb") as fo:
        if a.D:
            while (b := fi.read(1)):
                ks = rng.next_byte(); out = bytes([b[0]^ks]); print(f"{b[0]:02x} ^ {ks:02x} -> {out[0]:02x}")
                fo.write(out)
        else:
            while True:
                buf = bytearray(fi.read(65536))
                if not buf: break
                for i in range(len(buf)): buf[i] ^= rng.next_byte()
                fo.write(buf)

if __name__ == "__main__":
    try: main()
    except BrokenPipeError: pass
