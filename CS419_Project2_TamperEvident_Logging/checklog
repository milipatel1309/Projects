#!/usr/bin/python3
import hashlib, base64, sys, os

def sha256_digest(s: str) -> bytes:
    return hashlib.sha256(s.encode('utf-8')).digest()

def b64tail24(s: str) -> str:
    return base64.b64encode(sha256_digest(s)).decode()[-24:]

# 1) no args allowed
if len(sys.argv) > 1:
    print("failed: args")
    sys.exit(1)

# 2) detect missing files
if not os.path.exists("log.txt"):
    print("failed: missing log")
    sys.exit(1)
if not os.path.exists("loghead.txt"):
    print("failed: missing head")
    sys.exit(1)

# 3) read lines
lines = open("log.txt").read().splitlines()
if not lines:
    print("failed: empty")
    sys.exit(1)

# 4) first line must have 'start'
parts = lines[0].split()
if len(parts) < 4 or parts[2] != "-" or parts[3] != "start":
    print("failed:1")
    sys.exit(1)

# 5) verify chain
for i in range(len(lines) - 1):
    cur_line = lines[i]
    nxt_line = lines[i + 1].split()
    if len(nxt_line) < 4:
        print(f"failed:{i+2}")
        sys.exit(1)
    expected = b64tail24(cur_line)
    actual = nxt_line[3]
    if actual != expected:
        print(f"failed:{i+2}")
        sys.exit(1)

# 6) verify head pointer file
computed_head = b64tail24(lines[-1])
stored_head = open("loghead.txt").read().strip()
if computed_head != stored_head:
    print(f"failed:{len(lines)}")
    sys.exit(1)

print("valid")
sys.exit(0)

